<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AirFlash.UI"
        xmlns:vm="using:AirFlash.UI.ViewModels"
        x:Class="AirFlash.UI.Views.MainWindow"
        x:DataType="vm:AppViewModel"
        Title="AirFlash"
        Width="460"
        Height="640"
        MinWidth="440"
        MinHeight="420"
        CanResize="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.ReceiverCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.ReceiverCard.Active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16" Background="{DynamicResource CanvasBrush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
      <Grid Margin="2,0,0,18" ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/app.png" Width="26" Height="26" VerticalAlignment="Center" Margin="0,2,10,0" />
          <TextBlock Text="AirFlash" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="IconButton" ToolTip.Tip="{loc:Text 'Settings'}" Click="OnSettings" Margin="0,0,7,0">
          <!-- Vector, not a private-use glyph: Linux has no Segoe Fluent Icons. -->
          <Viewbox Width="16" Height="16">
            <Path Fill="{DynamicResource TextBrush}"
                  Data="M12,2.25 C12.73,2.26 13.46,2.34 14.18,2.5 C14.49,2.57 14.72,2.83 14.76,3.15 L14.93,4.68 C15,5.38 15.6,5.91 16.3,5.91 C16.49,5.91 16.68,5.87 16.85,5.79 L18.25,5.18 C18.55,5.05 18.89,5.12 19.1,5.35 C20.12,6.43 20.87,7.73 21.31,9.15 C21.4,9.45 21.29,9.78 21.04,9.97 L19.8,10.89 C19.44,11.15 19.23,11.56 19.23,12 C19.23,12.44 19.44,12.85 19.8,13.11 L21.04,14.03 C21.3,14.22 21.4,14.55 21.31,14.85 C20.87,16.27 20.12,17.56 19.11,18.65 C18.89,18.88 18.55,18.95 18.26,18.82 L16.85,18.2 C16.45,18.03 15.99,18.05 15.61,18.27 C15.23,18.49 14.97,18.88 14.93,19.32 L14.76,20.84 C14.72,21.16 14.49,21.42 14.19,21.49 C12.74,21.84 11.23,21.84 9.78,21.49 C9.47,21.42 9.24,21.16 9.21,20.84 L9.04,19.32 C8.99,18.88 8.73,18.5 8.35,18.28 C7.97,18.06 7.51,18.03 7.11,18.21 L5.71,18.83 C5.41,18.95 5.07,18.88 4.86,18.65 C3.85,17.57 3.09,16.27 2.65,14.85 C2.56,14.55 2.67,14.22 2.93,14.03 L4.17,13.11 C4.52,12.85 4.73,12.44 4.73,12 C4.73,11.56 4.52,11.15 4.17,10.89 L2.93,9.97 C2.67,9.78 2.56,9.45 2.65,9.15 C3.09,7.73 3.85,6.44 4.86,5.35 C5.08,5.12 5.42,5.05 5.71,5.18 L7.11,5.8 C7.51,5.97 7.97,5.95 8.36,5.72 C8.74,5.5 8.99,5.11 9.04,4.68 L9.21,3.15 C9.24,2.83 9.48,2.57 9.79,2.5 C10.51,2.34 11.24,2.26 12,2.25 Z M12,8.25 C14.07,8.25 15.75,9.93 15.75,12 C15.75,14.07 14.07,15.75 12,15.75 C9.93,15.75 8.25,14.07 8.25,12 C8.25,9.93 9.93,8.25 12,8.25 Z M12,9.75 C10.76,9.75 9.75,10.76 9.75,12 C9.75,13.24 10.76,14.25 12,14.25 C13.24,14.25 14.25,13.24 14.25,12 C14.25,10.76 13.24,9.75 12,9.75 Z" />
          </Viewbox>
        </Button>
        <Button Grid.Column="2" Classes="IconButton" ToolTip.Tip="{loc:Text 'Quit'}" Click="OnQuit">
          <Viewbox Width="18" Height="18">
            <Path Data="M 10,3 L 3,3 3,21 10,21 M 8,12 L 22,12 M 17,7 L 22,12 17,17"
                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Viewbox>
        </Button>
      </Grid>
      <Border Grid.Row="1" Padding="10" CornerRadius="6" Background="{DynamicResource TintBrush}" Margin="0,0,0,12"
              IsVisible="{Binding Notice, Converter={StaticResource NonEmpty}}">
        <TextBlock Text="{Binding Notice}" Classes="HintText" />
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
        <StackPanel>
          <Border x:Name="EmptyState" Classes="ReceiverCard" Padding="18,28" IsVisible="{Binding !Receivers.Count}">
            <StackPanel>
              <TextBlock Text="{loc:Text 'Searching for receivers'}" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="{loc:Text 'Connect your PC and HomePod to the same network,&#10;or add a receiver in settings.'}"
                         Classes="HintText" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Receivers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReceiverViewModel">
                <Border Classes="ReceiverCard" Classes.Active="{Binding Active}" CornerRadius="10">
                  <Grid ColumnDefinitions="42,*,42" RowDefinitions="Auto,Auto">
                    <Border Background="{DynamicResource TintBrush}" Width="32" Height="36" CornerRadius="8" VerticalAlignment="Top">
                      <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="{DynamicResource AccentBrush}"
                              Data="M15,4.25 C15,3.17 13.73,2.6 12.92,3.32 L8.43,7.31 C8.29,7.43 8.11,7.5 7.93,7.5 H4.25 C3.01,7.5 2,8.51 2,9.75 V14.25 C2,15.49 3.01,16.5 4.25,16.5 H7.93 C8.11,16.5 8.29,16.56 8.43,16.69 L12.92,20.68 C13.73,21.4 15,20.82 15,19.75 Z M18.99,5.9 C19.32,5.65 19.79,5.72 20.04,6.05 C21.27,7.72 22,9.77 22,12 C22,14.23 21.27,16.28 20.04,17.95 C19.79,18.28 19.32,18.35 18.99,18.1 C18.66,17.86 18.59,17.39 18.84,17.05 C19.88,15.64 20.5,13.89 20.5,12 C20.5,10.11 19.88,8.36 18.84,6.95 C18.59,6.61 18.66,6.14 18.99,5.9 Z M17.14,8.37 C17.51,8.17 17.96,8.31 18.16,8.67 C18.7,9.66 19,10.8 19,12 C19,13.2 18.7,14.34 18.16,15.33 C17.96,15.69 17.51,15.83 17.14,15.63 C16.78,15.43 16.64,14.98 16.84,14.61 C17.26,13.84 17.5,12.95 17.5,12 C17.5,11.05 17.26,10.16 16.84,9.39 C16.64,9.02 16.78,8.57 17.14,8.37 Z" />
                      </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StateText}" Classes="HintText" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="IconButton" Content="{Binding PlayGlyph}" Command="{Binding ToggleCommand}"
                            ToolTip.Tip="{Binding PlayHint}" Foreground="{DynamicResource AccentBrush}" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,9,0,0" ColumnDefinitions="108,*,40,Auto">
                      <TextBlock Text="{Binding VolumeStatus}" Classes="HintText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                      <Slider Grid.Column="1" Classes="AccentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                              Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Text 'Device volume'}" />
                      <TextBlock Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource MutedBrush}" />
                      <Button Grid.Column="3" Content="{Binding MuteLabel}" Command="{Binding MuteCommand}" Width="64" Padding="8,4" Margin="10,0,0,0" FontSize="11" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="3">
        <Grid Margin="2,4,2,14" ColumnDefinitions="*,190">
          <TextBlock Text="{loc:Text 'Latency mode'}" VerticalAlignment="Center" Classes="HintText" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:Choices.Latencies}" DisplayMemberBinding="{Binding Label}"
                    SelectedValueBinding="{Binding Value}" SelectedValue="{Binding LatencyMode, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
        </Grid>
        <Border Padding="12" Margin="0,0,0,10" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="108,*,40,Auto">
            <TextBlock Text="{loc:Text 'Master volume'}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold" />
            <Slider Grid.Column="1" Classes="AccentSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding MasterVolume, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="{loc:Text 'Master volume'}" />
            <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="{Binding MuteLabel}" Command="{Binding MuteCommand}" Width="64" Padding="8,4" Margin="10,0,0,0" FontSize="11" />
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Grid.Row="4" Margin="2,4,2,0">
        <DockPanel>
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
          <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="12" />
        </DockPanel>
        <TextBlock Text="{Binding StatusDetail}" Classes="HintText" Margin="13,4,0,0" MaxHeight="62" TextTrimming="CharacterEllipsis" />
        <Expander Header="{loc:Text 'View error details'}" IsVisible="{Binding ErrorDetails, Converter={StaticResource NonEmpty}}" Margin="0,8,0,0">
          <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding ErrorDetails}" Classes="HintText" Margin="0,8,0,0" />
          </ScrollViewer>
        </Expander>
      </StackPanel>
    </Grid>
  </Border>
</Window>
